# HDFS
# Default to existing host cluster (Mac Docker Desktop).
# If you want the local compose namenode instead, set these back to namenode:9870/9000.
HDFS_NAMENODE_HTTP=http://host.docker.internal:9870
HDFS_NAMENODE_RPC=hdfs://host.docker.internal:9000
HDFS_USER=root

# UI/existing indexed dataset
DEFAULT_USER_ID=team_gallery
RAW_UI_IMAGE_ROOT=/photos/raw/team_gallery/images
THUMBNAIL_UI_ROOT=/photos/thumbnails/team_gallery
METADATA_INPUT_DIR=/app/data/existing_metadata
ANNOTATION_DIR=/app/data/annotations
ANNOTATION_ALT_DIR=/app/data/mirflickr25k_annotations_v080
ANNOTATION_DATASET=mirflickr25k
EXISTING_INDEX_DIR=/app/data/existing_index
IMPORTED_METADATA_ROOT=/photos/metadata/imported
UI_ACTIVE_METADATA_ROOT=/photos/metadata/ui_active
VECTOR_INDEX_ROOT=/photos/vector_index/current
DELETE_METADATA_ROOT=/photos/metadata/deletes
SCAN_HDFS_IF_METADATA_MISSING=true
MAX_IMPORT_SCAN_FILES=0
MAX_THUMBNAILS=0
PROJECT_DATA_ROOT=/app/data
EXIF_SHARD_ROOT=/app/data/exif_11db
TAGS_SHARD_ROOT=/app/data/tags_11gb
THUMB_SHARD_ROOT=/app/data/thumb_11gb

# MIRFLICKR 25K pipeline
MIRFLICKR25K_RAW_ROOT=/photos/raw/mirflickr25k/images
MIRFLICKR25K_BASIC_ROOT=/photos/metadata/mirflickr25k/basic
MIRFLICKR25K_ENRICHED_ROOT=/photos/metadata/mirflickr25k/enriched
MAX_VLM_IMAGES=1000
OLLAMA_MODEL=llava
OLLAMA_URL=http://ollama:11434/api/generate

# Upload/Kafka/Ray
UPLOAD_RAW_ROOT=/photos/raw/uploads
UPLOAD_METADATA_ROOT=/photos/metadata/uploads
THUMBNAIL_ROOT=/photos/thumbnails/uploads
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_UPLOADED=image_uploaded
KAFKA_TOPIC_LABELED=image_labeled
KAFKA_TOPIC_FAILED=processing_failed
KAFKA_TOPIC_DELETED=image_deleted
RAY_ADDRESS=auto
RAY_SERVE_URL=http://ray-head:8000/predict
MODEL_HDFS_PATH=/photos/models/image_classifier/model.pkl
MODEL_METRICS_HDFS_PATH=/photos/models/image_classifier/metrics.json
SYNC_UPLOAD_FALLBACK=false
EMBEDDING_DIM=128
LOCAL_STATE_DIR=/app/state
EDA_OUTPUT_DIR=/app/outputs/eda
